<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pe.edu.upeu.sysventas.cine.CandyController">

    <top>
        <Label text="CRUD Chuche Administrator"
               style="-fx-font-size: 22px; -fx-font-weight: bold;">
            <BorderPane.margin>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </BorderPane.margin>
        </Label>
    </top>

    <center>
        <VBox spacing="10"
              fillWidth="false">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <GridPane hgap="10" vgap="10">

                <Label text="Nombre:"
                       GridPane.rowIndex="0"/>

                <TextField fx:id="txtNombre"
                           promptText="Nombre del producto"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>

                <Label text="Tipo:"
                       GridPane.rowIndex="1"/>

                <TextField fx:id="txtTipo"
                           promptText="Tipo de golosina"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"/>

                <Label text="Precio:"
                       GridPane.rowIndex="2"/>

                <TextField fx:id="txtPrecio"
                           promptText="Precio"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2"/>

                <Label text="Stock:"
                       GridPane.rowIndex="3"/>

                <TextField fx:id="txtStock"
                           promptText="Cantidad disponible"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="3"/>
            </GridPane>

            <HBox spacing="10">
                <Button text="Crear"
                        onAction="#crearCandy"/>

                <Button text="Actualizar"
                        onAction="#actualizarCandy"/>

                <Button text="Eliminar"
                        onAction="#eliminarCandy"/>

                <Button text="Limpiar"
                        onAction="#limpiar"/>
            </HBox>

            <TableView fx:id="tablaCandys"
                       prefWidth="650.0"
                       prefHeight="280.0"
                       minWidth="650.0"
                       maxWidth="650.0"
                       minHeight="280.0"
                       maxHeight="280.0">

                <columns>
                    <TableColumn fx:id="colNombre"
                                 text="Nombre del producto"
                                 prefWidth="190"/>

                    <TableColumn fx:id="colTipo"
                                 text="Tipo"
                                 prefWidth="140"/>

                    <TableColumn fx:id="colPrecio"
                                 text="Precio"
                                 prefWidth="100"/>

                    <TableColumn fx:id="colStock"
                                 text="Stock"
                                 prefWidth="100"/>
                </columns>
            </TableView>

            <Label fx:id="lblMensaje"
                   text=""/>
        </VBox>
    </center>

</BorderPane>